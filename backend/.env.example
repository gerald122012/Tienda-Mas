# Copia este archivo a backend/.env y complétalo solo en tu computadora.
# No envíes el token por el chat ni lo subas al repositorio.

# mock: respuestas ficticias. live: API Perú. El predeterminado es mock.
DNI_MODE=mock

PORT=3000
HOST=127.0.0.1

# Déjalo vacío en modo simulado. En modo real, escribe aquí el token
# que te entregue el proveedor. Este archivo de ejemplo no contiene secretos.
APISPERU_TOKEN=

# MassBot. mock no llama a Gemini ni a Firestore. live exige las claves.
# CHAT_MODE es independiente de DNI_MODE.
CHAT_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
