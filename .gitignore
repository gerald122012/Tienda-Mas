# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local secrets and signing files
.env
.env.*
!.env.example
*.jks
*.keystore
**/key.properties
**/*service-account*.json
**/*service_account*.json

# Local Python caches and database backups
__pycache__/
tools/**/firestore_antes*.json
tools/**/respaldo*/

# Firebase CLI local cache. Logs are already covered by *.log.
.firebase/
